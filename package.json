{
  "name": "tigrent",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.75.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "~26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "pg": "^8.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:app": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects app",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects db",
    "db:ping": "node scripts/db-ping.mjs",
    "db:status": "node scripts/db-migrate.mjs --status",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs && node scripts/db-seed-files.mjs",
    "db:reset-demo": "node scripts/db-reset-demo.mjs",
    "db:types": "node --experimental-vm-modules scripts/gen-db-types.mjs",
    "db:smoke": "node scripts/db-smoke.mjs",
    "db:seed-files": "node scripts/db-seed-files.mjs",
    "e2e:journey-a": "node scripts/journey-a.mjs",
    "e2e:journey-b": "node scripts/journey-b.mjs",
    "e2e:journey-c": "node scripts/journey-c.mjs",
    "e2e:journey-d": "node scripts/journey-d.mjs",
    "e2e:journey-e": "node scripts/journey-e.mjs",
    "e2e:journey-trust": "node scripts/journey-trust.mjs",
    "e2e:journey-f": "node scripts/journey-f.mjs"
  },
  "private": true,
  "jest": {
    "testTimeout": 60000,
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
          "<rootDir>/src/test/setup.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1",
          "^@assets/(.*)$": "<rootDir>/assets/$1",
          "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/.expo/"
        ],
        "resolver": "react-native-reanimated/jest/resolver",
        "testMatch": [
          "<rootDir>/src/**/*.test.[jt]s?(x)"
        ]
      },
      {
        "displayName": "db",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/supabase/tests/**/*.test.ts"
        ],
        "transform": {
          "^.+.tsx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      }
    ]
  }
}
