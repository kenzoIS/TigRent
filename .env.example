# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tooling only. Never prefix with EXPO_PUBLIC_, never commit, never use the service-role key in the app.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=

# Optional: resolved automatically by scripts/db-ping.mjs if omitted
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
